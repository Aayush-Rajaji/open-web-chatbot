# Copy this file to .env.local for local testing (never commit .env.local!)
# At least one provider key is optional; without keys, the bot uses canonical + fallback responses.

# Primary LLM: Google Gemini (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Secondary LLM fallback: OpenRouter (free models available at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Restrict cross-origin requests when hosting the API separately from your frontend
# Use * for public widgets or your exact domain, e.g. https://your-site.github.io
ALLOWED_ORIGIN=*
